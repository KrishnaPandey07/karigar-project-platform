# ==============================================================================
# कारीगर (Karigar) Platform - Environment Variables Template
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Local: postgresql://postgres:postgres@localhost:5432/karigar?schema=public
# 24/7 Cloud (Neon / Supabase): postgresql://user:password@ep-xyz.neon.tech/karigar?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/karigar?schema=public

# Authentication Security (JWT & Cookies)
JWT_ACCESS_SECRET=karigar_access_secret_super_secure_key_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=karigar_refresh_secret_super_secure_key_67890
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=karigar_cookie_signing_secret_abcdef

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=http://localhost:5173

# Cloud Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
